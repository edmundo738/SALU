{
  "name": "salu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SALU — plataforma que torna oportunidades de serviço em Angola persistentes e pesquisáveis.",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.77.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^5.1.1"
  }
}
