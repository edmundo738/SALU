# API persistente (Express + SQLite com volume, ou Postgres gerido).
# Em produção, usa HTTPS e o domínio real da API.
# Deixa VITE_API_URL vazio em desenvolvimento para usar o proxy /api do Vite.
VITE_API_URL=
# O proxy de desenvolvimento encaminha /api para este servidor.
SALU_API_URL=http://127.0.0.1:3001

# Email público de suporte (opcional). Se ficar vazio, a UI diz que o canal
# ainda não está configurado em vez de inventar um endereço.
VITE_SUPPORT_EMAIL=

# Servidor
PORT=3001
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SALU_DATA_DIR=./data
SALU_ADMIN_TOKEN=troca-este-token-por-um-segredo-longo

# Nunca coloques segredos reais neste ficheiro.
