# Supabase — necessário para o modo multi-utilizador (piloto).
# Sem estas variáveis a aplicação arranca em MODO LOCAL:
# os dados ficam apenas no dispositivo onde foram criados.
#
# Copiar para `.env.local` e preencher com os valores do projecto Supabase.
# A chave `anon` é pública por desenho; a segurança vive nas políticas RLS.
# NUNCA colocar aqui a chave `service_role`.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
